# This repo's dev server and production build already set VITE_USE_MOCK=true
# in .env.development and .env.production. A shell value overrides those files.
#
# Same origin as the FastAPI app:
# VITE_USE_MOCK=false
# VITE_API_BASE=
#
# Another origin:
# VITE_USE_MOCK=false
# VITE_API_BASE=http://127.0.0.1:8000
#
# VITE_API_BASE_URL is the previous name of VITE_API_BASE. It is used only when
# VITE_API_BASE is unset, and it does not enable the mock.
